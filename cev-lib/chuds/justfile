# use powershell on windows
set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

# run from the repo root, where CMakePresets.json lives
set working-directory := "../.."

[private]
default:
    @just --justfile {{ source_file() }} --list

configure:
    cmake --preset host

build: configure
    cmake --build --preset host

test: build
    ctest --preset host

clean:
    cmake -E rm -rf build/host

# create a virtual CAN-FD interface for the socketcan tests and chuds_demo
[linux]
vcan-up iface="vcan0":
    sudo modprobe vcan
    if ! ip link show {{ iface }} >/dev/null 2>&1; then sudo ip link add dev {{ iface }} type vcan; fi
    sudo ip link set {{ iface }} down
    sudo ip link set {{ iface }} mtu 72
    sudo ip link set up {{ iface }}

# install a service that brings can0 up at the bus settings in frame.hpp whenever it appears
# rerun after changing frame.hpp
[linux]
install-can: configure
    cmake --build --preset host --target can_link_args
    sudo install -m 755 build/host/cev-lib/chuds/tools/can_link_args /usr/local/bin/can_link_args
    sudo install -m 644 cev-lib/chuds/tools/can0-up.service /etc/systemd/system/can0-up.service
    sudo systemctl daemon-reload
    sudo systemctl enable can0-up.service
    if ip link show can0 >/dev/null 2>&1; then sudo systemctl restart can0-up.service; fi
