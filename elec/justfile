# use powershell on windows
set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

# run from the repo root, where CMakePresets.json lives
set working-directory := ".."

[private]
default:
    @just --justfile {{ source_file() }} --list

# configure all targets
configure:
    cmake --preset firmware

# build all targets
build: configure
    cmake --build --preset firmware

# build a single target
build-target target: configure
    cmake --build --preset firmware --target {{ target }}

# clean build artifacts
clean:
    cmake -E rm -rf build/firmware

# flash a project onto a pico
flash target: configure
    cmake --build --preset firmware --target flash_{{ target }}

# ensure installed toolchain versions are as expected
doctor:
    @cmake -P elec/setup/doctor.cmake
